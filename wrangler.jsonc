{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-pixel-cinematic-showcase",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    {
      "pattern": "nexa-pixel.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nexa-pixel.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
